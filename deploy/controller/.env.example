# Blank builds locally. Published images must use an explicit version.
IP_GUARD_IMAGE=
# One-to-one mapping: public entry addresses -> assigned local private addresses.
ENTRY_IPS=192.0.2.10,198.51.100.20,203.0.113.30
SOURCE_IPS=10.0.0.10,10.0.0.20,10.0.0.30
DNS_NAME=edge.example.com
# Each unique named endpoint has one vote; these are three regions of ONE cloud vendor.
PROBE_TARGETS='[{"name":"beijing","host":"oss-cn-beijing.aliyuncs.com","port":443},{"name":"hangzhou","host":"oss-cn-hangzhou.aliyuncs.com","port":443},{"name":"shenzhen","host":"oss-cn-shenzhen.aliyuncs.com","port":443}]'
PROBE_INTERVAL_SECONDS=60
PROBE_TIMEOUT_SECONDS=4
STALE_AFTER_SECONDS=150
MAX_SAMPLE_AGE_SECONDS=90
FAILURE_RATIO=0.5
HEALTHY_RATIO=0.8
FAILURE_THRESHOLD=3
HEALTHY_THRESHOLD=3
COOLDOWN_SECONDS=900
# REQUIRED: explicitly choose live (real DNS failover) or simulate (never writes DNS).
# No default: an empty RUN_MODE blocks failover and reports an unconfigured mode.
RUN_MODE=
# Required ONLY for live, after reviewing DNS scope, mapping, probes and backups:
# ENABLE_DNS_WRITES=I_HAVE_REVIEWED_DRY_RUN
# Legacy DRY_RUN=true/false is supported only when RUN_MODE is absent;
# do not copy a conflicting legacy DRY_RUN setting into this file.
ENABLE_DNS_WRITES=
ADMIN_TOKEN=
# Loopback always provides local admin/health; optional additional private metrics listener.
CONTROLLER_BIND_IP=127.0.0.1
CF_API_TOKEN=
CF_ZONE_ID=
CF_RECORD_ID=
FEISHU_WEBHOOK=
FEISHU_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_VIA_GRAFANA=false
