{
  "uid": "oci-ip-guard",
  "title": "OCI IP Guard · 单机区域探测",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "oci-ip-guard"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 16,
      "title": "DNS 自动切换实际状态（以此为准）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "2 * oci_guard_auto_switch_available + oci_guard_mode_simulate",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无当前数据，不能判断",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "自动切换不可用",
                  "color": "red"
                },
                "1": {
                  "text": "模拟模式：故障时不会修改 DNS",
                  "color": "orange"
                },
                "2": {
                  "text": "DNS 自动切换已启用",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 17,
      "title": "容器工作线程 / 心跳",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oci_guard_worker_healthy",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无当前数据，不能判断",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "未就绪",
                  "color": "red"
                },
                "1": {
                  "text": "通过（不是切换成功）",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 18,
      "title": "探测样本有效",
