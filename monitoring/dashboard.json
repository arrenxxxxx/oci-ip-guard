  "panels": [
    {
      "id": 16,
      "title": "自动切换",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "2 * oci_guard_auto_switch_available{job=\"oci-ip-guard\",instance=\"$instance\"} + oci_guard_mode_simulate{job=\"oci-ip-guard\",instance=\"$instance\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无当前数据",
          "color": {
            "mode": "fixed",
            "fixedColor": "#A8B6CD"
          },
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "暂不可用",
                  "color": "#F4777F"
                },
                "1": {
                  "text": "仅观察 · 不改 DNS",
                  "color": "#F5B66C"
