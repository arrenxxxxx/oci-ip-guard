          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 20,
      "title": "自动切换保护原因（详细解释见 status）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oci_guard_auto_switch_blocked == 1",
          "legendFormat": "{{instance}} · {{reason}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无阻止原因或无数据，请同时核对上方状态",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "阻止切换",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 1,
      "title": "模拟观察标志（1=不会修改 DNS）",
