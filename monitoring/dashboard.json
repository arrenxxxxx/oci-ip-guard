  "annotations": {
    "list": [
      {
        "name": "DNS / Dry Run events",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(oci_guard_events_total[1m]) > 0",
        "step": "15s",
        "tagKeys": "kind",
        "titleFormat": "{{kind}}"
      }
    ]
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "description": "优先展示实际 DNS 自动切换可用性，区分模拟观察、保护阻止、控制器存活与探测有效。单机源地址区域 TCP 探测，不代表 VPN 入站验收。"
}
