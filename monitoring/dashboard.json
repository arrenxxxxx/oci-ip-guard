          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(oci_guard_current_ip{job=\"oci-ip-guard\"},instance)",
        "query": {
          "query": "label_values(oci_guard_current_ip{job=\"oci-ip-guard\"},instance)",
          "refId": "instance"
        },
        "refresh": 1,
        "hide": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "current": {}
